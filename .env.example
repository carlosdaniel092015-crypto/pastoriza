# ============================================================
# Copiá a .env y completá. NUNCA subas el .env al repo.
# TODAS estas credenciales estaban en texto plano en el JSON de n8n:
# rotalas antes de usarlas acá.
# ============================================================

APP_ENV=production
LOG_LEVEL=INFO

# Token propio que vas a configurar en el webhook de YCloud (header X-Webhook-Token).
# Dejalo vacío SOLO en desarrollo local.
WEBHOOK_TOKEN=cambiame-por-algo-largo-y-aleatorio

# Token del panel de operación (/panel) y de los endpoints /admin/* y de config.
# OBLIGATORIO en producción: si queda vacío, esos endpoints quedan SIN auth.
# Generá uno largo y aleatorio (ej: openssl rand -hex 32).
PANEL_TOKEN=cambiame-por-algo-largo-y-aleatorio

# ---------------- Redis ----------------
# Reusá el Redis que ya usa n8n. El prefijo evita colisiones de keys.
# Si Redis corre en otro contenedor de Dokploy, usá su nombre de servicio.
REDIS_URL=redis://redis:6379/1
REDIS_PREFIX=pastoriza:
SESSION_TTL_SECONDS=86400
SESSION_MAX_ITEMS=40

# ---------------- Debounce ----------------
# Ventana de espera para agrupar la ráfaga de mensajes del cliente.
DEBOUNCE_SECONDS=6
DEBOUNCE_MAX_WAIT=25

# ---------------- OpenAI ----------------
OPENAI_API_KEY=sk-proj-ROTALA
MODEL_AGENTE=gpt-4o
MODEL_VISION=gpt-4o-mini
MODEL_TRANSCRIPCION=whisper-1
AGENTE_MAX_TURNS=12
# Timeouts (opcionales, tienen default). Techo por llamada a OpenAI y por turno
# completo del agente; el del turno debe quedar por debajo del TTL del lock.
OPENAI_TIMEOUT=30
AGENTE_TIMEOUT=90

# ---------------- YCloud ----------------
YCLOUD_API_KEY=ROTALA
YCLOUD_BASE_URL=https://api.ycloud.com/v2
# Número/WABA emisor. Si lo dejás vacío se toma del propio webhook.
YCLOUD_FROM=
ADMIN_PHONE=+18294716701
TEMPLATE_ALERTA_SUPERVISOR=alerta_supervisor_cliente
TEMPLATE_PEDIDO_CREADO=notificar_pedido_creado
TEMPLATE_LANG=es_DO

# ---------------- Odoo (XML-RPC) ----------------
ODOO_URL=https://pastorizaplastic.net
ODOO_DB=pastoriza-plastics
ODOO_USER=usuario@pastorizaplastic.net
ODOO_PASSWORD=ROTALA
ODOO_UID_FALLBACK=2
ODOO_COUNTRY_ID=61
ODOO_TIMEOUT=30

# ---------------- Catálogo ----------------
WEBSITE_PRICELIST_ID=0
PRECIOS_GUARDADOS_CON_ITBIS=true
ITBIS_RATE=0.18
CATALOGO_CACHE_SECONDS=300
MAX_IMAGENES_POR_MENSAJE=5

# ---------------- Telegram (alertas, opcional) ----------------
# Si faltan, no notifica por Telegram. Ojo: algunas redes corporativas bloquean
# api.telegram.org; suele funcionar desde el server de producción.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Migración gradual ----------------
# Mientras convivís con n8n: SOLO estos números pasan por el servicio nuevo.
# Vaciá esta variable cuando quieras que atienda a todos.
ALLOWLIST_NUMEROS=18091234567
